---
const creations = [
  { title: 'Deep earth', pcImg: '/desktop/image-deep-earth.jpg' },
  { title: 'Night arcade', pcImg: '/desktop/image-night-arcade.jpg' },
  { title: 'Soccer team VR', pcImg: '/desktop/image-soccer-team.jpg' },
  { title: 'The grid', pcImg: '/desktop/image-grid.jpg' },
  { title: 'From up above VR', pcImg: '/desktop/image-from-above.jpg' },
  { title: 'Pocket borealis', pcImg: '/desktop/image-pocket-borealis.jpg' },
  { title: 'The curiosity', pcImg: '/desktop/image-curiosity.jpg' },
  { title: 'Make it fisheye', pcImg: '/desktop/image-fisheye.jpg' },
];
---
<section class="py-24 px-6 md:px-40 bg-blanco">
  <div class="flex justify-between items-center mb-12">
    <h2 class="text-3xl md:text-5xl font-josefin uppercase">Our Creations</h2>
    <button class="hidden md:block border-2 border-negro px-10 py-2 font-alata uppercase tracking-[0.3em] hover:bg-negro hover:text-blanco transition">
      See All
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
    {creations.map((item) => (
      <div class="relative group cursor-pointer overflow-hidden">
        <img src={item.pcImg} alt={item.title} class="w-full transition duration-300 group-hover:opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        <h3 class="absolute bottom-8 left-8 text-blanco font-josefin text-3xl uppercase w-32 leading-none">
          {item.title}
        </h3>
      </div>
    ))}
  </div>
  
  <button class="md:hidden w-full mt-8 border-2 border-negro px-10 py-2 font-alata uppercase tracking-[0.3em]">
    See All
  </button>
</section>